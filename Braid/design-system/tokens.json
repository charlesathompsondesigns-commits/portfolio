{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Braid Design System",
  "version": "1.1.0",
  "font": {
    "display":  { "value": "Gyst Variable, Playfair Display, Georgia, serif", "role": "Display / Brand", "weight": "Bold" },
    "body":     { "value": "Roboto, system-ui, sans-serif",  "role": "Body / Product / Nav", "weight": "Regular / Medium" },
    "utility":  { "value": "Inter, system-ui, sans-serif",  "role": "Utility / Data", "weight": "Medium" },
    "system":   { "value": "SF Pro Text, system-ui, sans-serif", "role": "OS chrome only", "weight": "Medium" }
  },
  "typeScale": {
    "displayXl": { "size": 42, "weight": "Bold",    "family": "display", "usage": "Hero & page titles" },
    "price":     { "size": 30, "weight": "Regular", "family": "body",    "usage": "Product pricing" },
    "section":   { "size": 20, "weight": "Bold",    "family": "display", "usage": "Section labels (POSTS, COURSES)" },
    "product":   { "size": 21, "weight": "Regular", "family": "body",    "usage": "Product & article headings" },
    "button":    { "size": 18, "weight": "Regular", "family": "body",    "usage": "CTA & profile nav buttons" },
    "body":      { "size": 16, "weight": "Regular", "family": "body",    "usage": "Nav labels, standard body copy" },
    "caption":   { "size": 14, "weight": "Regular", "family": "body",    "usage": "Sub-labels, secondary descriptions" },
    "meta":      { "size": 12, "weight": "Regular", "family": "body",    "usage": "Remaining time, micro labels" },
    "micro":     { "size": 10, "weight": "Medium",  "family": "utility", "usage": "Ratings, timestamps, tiny annotations" },
    "systemBar": { "size": 12, "weight": "Medium",  "family": "system",  "usage": "macOS/iOS system chrome" }
  },
  "color": {
    "background": {
      "deepIndigo":   { "value": "#18172C", "usage": "Primary page background" },
      "jetBlack":     { "value": "#171717", "usage": "NavBar, cards, close buttons" },
      "richNavy":     { "value": "#24213C", "usage": "Sticky headers, tab bars" },
      "mediumPurple": { "value": "#382A4D", "usage": "Sections, panel cards" },
      "darkPurple":   { "value": "#221E3C", "usage": "Badge & pill backgrounds" },
      "darkCharcoal": { "value": "#1F1F22", "usage": "Toggle base, input fields" }
    },
    "text": {
      "pureWhite": { "value": "#FFFEFE",                   "usage": "Primary headings & body" },
      "softWhite": { "value": "#EFEFEF",                   "usage": "Active nav labels" },
      "warmGray":  { "value": "#C8BFBD",                   "usage": "Muted / inactive text" },
      "white90":   { "value": "rgba(255,255,255,0.90)",    "usage": "System bar text" },
      "white70":   { "value": "rgba(255,255,255,0.70)",    "usage": "Secondary product info" },
      "white60":   { "value": "rgba(255,255,255,0.60)",    "usage": "Tertiary labels, prices" }
    },
    "purple": {
      "lavender":    { "value": "#C8BCF6", "usage": "Light accent — icons, highlights, soft text" },
      "deepViolet":  { "value": "#5A199B", "usage": "Dark anchor — emphasis, CTA fill, gradients" }
    },
    "warm": {
      "amberOrange": { "value": "#FF9033", "usage": "Progress bars, CTA highlights" },
      "gold":        { "value": "#FFBF00", "usage": "Star / badge glow" }
    }
  },
  "gradient": {
    "pageFade":       "radial-gradient(120% 80% at 50% 0%, #2A2350 0%, #18172C 60%, #100F22 100%)",
    "purplePop":      "linear-gradient(135deg, #C8BCF6 0%, #5A199B 100%)",
    "orchidBloom":    "linear-gradient(140deg, #EBC8FE 0%, #CAA8E9 45%, #624884 100%)",
    "borderNebula":   "linear-gradient(135deg, #C8BCF6 0%, #624884 50%, #5A199B 100%)",
    "deepDusk":       "linear-gradient(180deg, #382A4D 0%, #221E3C 50%, #18172C 100%)",
    "violetSterling": "linear-gradient(135deg, #A7A4DF 0%, #5A199B 100%)",
    "warmFlare":      "linear-gradient(135deg, #FFBF00 0%, #FF9033 100%)"
  },
  "spacing": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24,
    "7": 32, "8": 40, "9": 48, "10": 64, "11": 80, "12": 96
  },
  "radius": {
    "sm": 12, "lg": 20, "pill": 999
  },
  "shadow": {
    "xs": "0 1px 2px rgba(0,0,0,0.25)",
    "sm": "0 2px 6px rgba(0,0,0,0.28)",
    "md": "0 8px 20px rgba(0,0,0,0.32)",
    "lg": "0 16px 40px rgba(0,0,0,0.40)",
    "xl": "0 28px 64px rgba(0,0,0,0.48)",
    "glowViolet": "0 0 24px rgba(151,117,230,0.35)",
    "glowWarm":   "0 0 24px rgba(255,144,51,0.32)"
  },
  "glass": {
    "style":      "glossy",
    "blur":       "blur(6px) saturate(160%)",
    "base":       "rgba(24,23,44,0.55)",
    "tint":       "linear-gradient(180deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.06) 38%, rgba(255,255,255,0.02) 62%, rgba(255,255,255,0.08) 100%)",
    "tintLifted": "linear-gradient(180deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.08) 38%, rgba(255,255,255,0.03) 62%, rgba(255,255,255,0.10) 100%)",
    "tintViolet": "linear-gradient(180deg, rgba(200,188,246,0.20) 0%, rgba(200,188,246,0.06) 38%, rgba(90,25,155,0.04) 62%, rgba(200,188,246,0.10) 100%)",
    "border":     "1px solid rgba(255,255,255,0.18)",
    "borderStrong":"1px solid rgba(255,255,255,0.28)",
    "shadow":     "inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -1px 0 rgba(0,0,0,0.25), 0 10px 28px rgba(0,0,0,0.32)",
    "shadowSoft": "inset 0 1px 0 rgba(255,255,255,0.22), 0 6px 18px rgba(0,0,0,0.26)"
  },
  "motion": {
    "easeOut":   "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "fast":  120,
    "base":  200,
    "slow":  320
  }
}
